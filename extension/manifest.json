{
  "manifest_version": 3,
  "name": "抖音内容读取桥",
  "version": "0.1.0",
  "description": "读取铭哥本地已登录抖音页面的可见内容并送入增长判断中枢。仅主动点击时抓取当前页，不绕过登录、不批量爬取。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.douyin.com/*", "http://localhost:8910/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抓取当前抖音页"
  },
  "background": {
    "service_worker": "background.js"
  }
}
